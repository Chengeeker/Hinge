<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Hinge-Setup</AssemblyName>
    <Version>1.4.14</Version>
    <AssemblyVersion>1.4.14.0</AssemblyVersion>
    <FileVersion>1.4.14.0</FileVersion>
    <InformationalVersion>1.4.14</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>Hinge.Setup</RootNamespace>
    <ApplicationIcon>..\windows\Hinge.App\Assets\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
