<Application
    x:Class="Hinge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Hinge.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
                <ResourceDictionary Source="Themes/HingeM3.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>

            <!-- Shared M3 page primitives. -->
            <Thickness x:Key="HingePageMargin">24,16,24,32</Thickness>
            <Thickness x:Key="HingeCardPadding">20</Thickness>
            <x:Double x:Key="HingeSectionSpacing">20</x:Double>
            <Style x:Key="HingePageStackStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="{StaticResource HingePageMargin}" />
                <Setter Property="Spacing" Value="{StaticResource HingeSectionSpacing}" />
                <Setter Property="MaxWidth" Value="960" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HingeSettingsPageStackStyle" TargetType="StackPanel" BasedOn="{StaticResource HingePageStackStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MaxWidth" Value="960" />
            </Style>
            <Style x:Key="HingeCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HingeM3SurfaceContainerLowBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource HingeM3ShapeExtraLarge}" />
                <Setter Property="Padding" Value="{StaticResource HingeCardPadding}" />
            </Style>
            <Style x:Key="HingePageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HingeM3HeadlineSmallStyle}" />
            <Style x:Key="HingePageDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource HingeM3BodyVariantStyle}" />
            <Style x:Key="HingeSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HingeM3SectionHeaderStyle}" />
            <Style x:Key="HingeCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource HingeM3CaptionStyle}" />
            <Style TargetType="TextBlock" BasedOn="{StaticResource HingeM3BodyStyle}" />
            <Style x:Key="HingeButtonStyle" TargetType="Button" BasedOn="{StaticResource HingeM3TextButtonStyle}" />
            <Style TargetType="Button" BasedOn="{StaticResource HingeM3TextButtonStyle}" />
            <Style TargetType="local:HandCursorButton" BasedOn="{StaticResource HingeM3TextButtonStyle}" />
            <Style x:Key="HingeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HingeM3IconButtonStyle}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource HingeM3TextFieldStyle}" />
            <Style TargetType="PasswordBox" BasedOn="{StaticResource HingeM3PasswordFieldStyle}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource HingeM3ComboBoxStyle}" />
            <Style TargetType="ListViewItem" BasedOn="{StaticResource HingeM3ListViewItemStyle}" />
            <Style TargetType="GridViewItem" BasedOn="{StaticResource HingeM3GridViewItemStyle}" />
            <Style TargetType="local:HandCursorListViewItem" BasedOn="{StaticResource HingeM3ListViewItemStyle}" />
            <Style TargetType="local:HandCursorGridViewItem" BasedOn="{StaticResource HingeM3GridViewItemStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
