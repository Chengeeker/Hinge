<Application
    x:Class="Hinge.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared page primitives. Keep spacing, typography and cards in one
                 place so every feature page responds to theme changes equally. -->
            <Thickness x:Key="HingePageMargin">24,16,24,32</Thickness>
            <Thickness x:Key="HingeCardPadding">20</Thickness>
            <x:Double x:Key="HingeSectionSpacing">16</x:Double>
            <Style x:Key="HingePageStackStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="{StaticResource HingePageMargin}" />
                <Setter Property="Spacing" Value="{StaticResource HingeSectionSpacing}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="HingeCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="{StaticResource HingeCardPadding}" />
            </Style>
            <Style x:Key="HingePageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HingePageDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HingeSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HingeCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- Keep action buttons aligned with WinUI's filled ComboBox surface.
                 Calendar day cells opt out explicitly because they form the grid. -->
            <Style x:Key="HingeButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource HingeButtonStyle}" />
            <Style x:Key="HingeIconButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
