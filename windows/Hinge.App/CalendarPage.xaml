<Page
    x:Class="Hinge.App.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Grid x:Name="RootGrid">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="24,0,24,32" Spacing="16" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="读取手机日历权限允许的本地日程。日期下方的标记表示当天有安排，点击日期查看详情。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新日程" Click="RefreshButton_Click" VerticalAlignment="Center" />
                </Grid>

                <InfoBar x:Name="StatusInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="日历" Message="等待连接设备。" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" MinWidth="0" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <CalendarView
                            x:Name="MonthCalendar"
                            SelectionMode="Single"
                            IsGroupLabelVisible="True"
                            CalendarViewDayItemChanging="MonthCalendar_DayItemChanging"
                            SelectedDatesChanged="MonthCalendar_SelectedDatesChanged" />
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SelectedDateText" Text="当天日程" FontSize="20" FontWeight="SemiBold" />
                            <ListView x:Name="EventsList" SelectionMode="None" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
