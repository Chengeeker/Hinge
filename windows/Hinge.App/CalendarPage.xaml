<Page
    x:Class="Hinge.App.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hinge.App"
    NavigationCacheMode="Required">
    <Grid x:Name="RootGrid">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Style="{StaticResource HingePageStackStyle}">
                <local:HingeWrapPanel Spacing="12" LineSpacing="8" JustifyLastLine="True">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="PreviousMonthButton"
                                Style="{StaticResource HingeIconButtonStyle}"
                                Click="PreviousMonthButton_Click"
                                ToolTipService.ToolTip="上个月"
                                AutomationProperties.Name="上个月">
                                <SymbolIcon Symbol="Back" />
                            </Button>
                            <TextBlock
                                x:Name="MonthTitle"
                                VerticalAlignment="Center"
                                Style="{StaticResource HingePageTitleStyle}"
                                Text="2026年9月" />
                            <Button
                                x:Name="NextMonthButton"
                                Style="{StaticResource HingeIconButtonStyle}"
                                Click="NextMonthButton_Click"
                                ToolTipService.ToolTip="下个月"
                                AutomationProperties.Name="下个月">
                                <SymbolIcon Symbol="Forward" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="CalendarSummaryText"
                            Style="{StaticResource HingePageDescriptionStyle}"
                            Text="连接 Android 手机后显示日程。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="RefreshButton"
                            Style="{StaticResource HingeIconButtonStyle}"
                            Click="RefreshButton_Click"
                            ToolTipService.ToolTip="刷新日程"
                            AutomationProperties.Name="刷新日程">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Button
                            x:Name="TodayButton"
                            Style="{StaticResource HingeIconButtonStyle}"
                            Click="TodayButton_Click"
                            ToolTipService.ToolTip="跳转到今天"
                            AutomationProperties.Name="跳转到今天">
                            <SymbolIcon Symbol="GoToToday" />
                        </Button>
                        <Button
                            x:Name="CreateButton"
                            Style="{StaticResource HingeIconButtonStyle}"
                            Click="CreateButton_Click"
                            ToolTipService.ToolTip="创建新日程"
                            AutomationProperties.Name="创建新日程">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                        <Button
                            x:Name="JumpDateButton"
                            Style="{StaticResource HingeIconButtonStyle}"
                            Click="JumpDateButton_Click"
                            ToolTipService.ToolTip="跳转到日期"
                            AutomationProperties.Name="跳转到日期">
                            <SymbolIcon Symbol="Calendar" />
                        </Button>
                    </StackPanel>
                </local:HingeWrapPanel>

                <Border Style="{StaticResource HingeCardStyle}" Padding="0">
                    <Grid x:Name="CalendarGrid" Padding="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="WeekdayHeaderGrid" Grid.Row="0" />
                        <Grid x:Name="MonthCellsGrid" Grid.Row="1" MinHeight="480" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource HingeCardStyle}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="SelectedDateText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="当天日程" />
                        <ListView x:Name="EventsList" SelectionMode="None" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
