<Page
    x:Class="Hinge.App.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Grid x:Name="RootGrid">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Margin="24,0,24,32" Spacing="16" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="PreviousMonthButton"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="PreviousMonthButton_Click"
                                ToolTipService.ToolTip="上个月">
                                <SymbolIcon Symbol="Previous" />
                            </Button>
                            <TextBlock
                                x:Name="MonthTitle"
                                VerticalAlignment="Center"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Text="2026年9月" />
                            <Button
                                x:Name="NextMonthButton"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="NextMonthButton_Click"
                                ToolTipService.ToolTip="下个月">
                                <SymbolIcon Symbol="Next" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="CalendarSummaryText"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="连接 Android 手机后显示日程。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="RefreshButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="RefreshButton_Click"
                            ToolTipService.ToolTip="刷新日程"
                            AutomationProperties.Name="刷新日程">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Button
                            x:Name="TodayButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="TodayButton_Click"
                            ToolTipService.ToolTip="跳转到今天"
                            AutomationProperties.Name="跳转到今天">
                            <SymbolIcon Symbol="GoToToday" />
                        </Button>
                        <Button
                            x:Name="CreateButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CreateButton_Click"
                            ToolTipService.ToolTip="创建新日程"
                            AutomationProperties.Name="创建新日程">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                        <Button
                            x:Name="JumpDateButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="JumpDateButton_Click"
                            ToolTipService.ToolTip="跳转到日期"
                            AutomationProperties.Name="跳转到日期">
                            <SymbolIcon Symbol="Calendar" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid x:Name="CalendarGrid" Padding="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="WeekdayHeaderGrid" Grid.Row="0" />
                        <Grid x:Name="MonthCellsGrid" Grid.Row="1" MinHeight="480" />
                    </Grid>
                </Border>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="SelectedDateText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="当天日程" />
                        <ListView x:Name="EventsList" SelectionMode="None" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
