<Page
    x:Class="Hinge.App.CloudRelaySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource HingePageStackStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackToSettingsButton"
                    Grid.Column="0"
                    Style="{StaticResource HingeIconButtonStyle}"
                    ToolTipService.ToolTip="返回设置"
                    AutomationProperties.Name="返回设置">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Cloud Relay" Style="{StaticResource HingePageTitleStyle}" />
                    <TextBlock Text="使用你自己的 Cloudflare Worker 与 R2，在局域网不可用时异步中转文件。" Style="{StaticResource HingePageDescriptionStyle}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="CloudRelayEnabledToggle" Header="启用 Cloud Relay" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="局域网连接仍然优先；两台已信任设备需要使用同一 Relay 加密密钥。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="CloudRelayEndpointTextBox" Header="Worker 地址" PlaceholderText="https://hinge-relay.example.workers.dev" />
                    <TextBox x:Name="CloudRelayKeyTextBox" Header="Relay 加密密钥" PlaceholderText="Base64URL 32 字节密钥" />
                    <PasswordBox x:Name="CloudRelayAdminTokenTextBox" Header="部署 Token（仅注册时使用）" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button x:Name="GenerateCloudRelayKeyButton" Content="生成密钥" />
                        <Button x:Name="CopyCloudRelayKeyButton" Content="复制密钥" />
                        <Button x:Name="SaveCloudRelayButton" Content="保存配置" />
                        <Button x:Name="RegisterCloudRelayButton" Content="注册此设备" />
                        <Button x:Name="TestCloudRelayButton" Content="测试 Worker" />
                    </StackPanel>
                    <TextBlock x:Name="CloudRelayStatusText" Text="未配置 Cloud Relay" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
