<Page
    x:Class="Hinge.App.FeaturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource HingePageStackStyle}">
            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FeatureIcon" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FeatureDescription" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="当前状态" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="FeatureStatus" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="FeatureActions" Orientation="Horizontal" Spacing="8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
