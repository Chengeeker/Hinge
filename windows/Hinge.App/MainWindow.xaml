<Window xmlns:local="using:Hinge.App"
    x:Class="Hinge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hinge">

    <Grid
        x:Name="PageRoot"
        SizeChanged="PageRoot_SizeChanged"
        ActualThemeChanged="PageRoot_ActualThemeChanged"
        Background="{ThemeResource HingeM3SurfaceContainerBrush}"
        AllowDrop="True"
        DragEnter="PageRoot_DragOver"
        DragOver="PageRoot_DragOver"
        DragLeave="PageRoot_DragLeave"
        Drop="PageRoot_Drop">

        <Grid
            Background="Transparent"
            AllowDrop="True"
            DragEnter="PageRoot_DragOver"
            DragOver="PageRoot_DragOver"
            DragLeave="PageRoot_DragLeave"
            Drop="PageRoot_Drop">
        <NavigationView
                x:Name="AppNavigation" AutomationProperties.AutomationId="MainWindow.AppNavigation"
                AllowDrop="True"
                PaneDisplayMode="Auto"
                OpenPaneLength="200"
                CompactPaneLength="72"
                HorizontalContentAlignment="Stretch"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                AlwaysShowHeader="False"
                IsTitleBarAutoPaddingEnabled="False"
                Loaded="AppNavigation_Loaded"
                PaneOpened="AppNavigation_PaneStateChanged"
                PaneClosed="AppNavigation_PaneStateChanged"
                DisplayModeChanged="AppNavigation_DisplayModeChanged"
                SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewMinimalContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentPresenterMargin">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <local:HandCursorNavigationViewItem Content="首页" AutomationProperties.AutomationId="Navigation.home" Tag="home">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Home" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
                <local:HandCursorNavigationViewItem Content="文件管理" AutomationProperties.AutomationId="Navigation.files" Tag="files">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
                <NavigationViewItemSeparator />
                <local:HandCursorNavigationViewItem Content="笔记" AutomationProperties.AutomationId="Navigation.notes" Tag="notes">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
                <local:HandCursorNavigationViewItem Content="待办" AutomationProperties.AutomationId="Navigation.todo" Tag="todo">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Accept" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
                <local:HandCursorNavigationViewItem Content="日历" AutomationProperties.AutomationId="Navigation.calendar" Tag="calendar">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
                <local:HandCursorNavigationViewItem Content="相册" AutomationProperties.AutomationId="Navigation.photos" Tag="photos">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
                <local:HandCursorNavigationViewItem Content="通知" AutomationProperties.AutomationId="Navigation.notificationHistory" Tag="notificationHistory">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Message" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <local:HandCursorNavigationViewItem Content="设置" AutomationProperties.AutomationId="Navigation.settings" Tag="settings">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
                <local:HandCursorNavigationViewItem Content="关于应用" AutomationProperties.AutomationId="Navigation.about" Tag="about">
                    <local:HandCursorNavigationViewItem.Icon><SymbolIcon Symbol="Help" /></local:HandCursorNavigationViewItem.Icon>
                </local:HandCursorNavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Border x:Name="WorkspaceSurface"
                    Margin="0,32,8,8"
                    CornerRadius="{StaticResource HingeM3ShapeExtraLarge}"
                    Background="{ThemeResource HingeM3SurfaceBrush}">
                    <Grid x:Name="WorkspaceContent"
                        Background="Transparent"
                        AllowDrop="True"
                        DragEnter="PageRoot_DragOver"
                        DragOver="PageRoot_DragOver"
                        DragLeave="PageRoot_DragLeave"
                        Drop="PageRoot_Drop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Image
                            x:Name="WindowBackgroundImage"
                            Grid.RowSpan="2"
                            Stretch="UniformToFill"
                            Opacity="0.10"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                        <InfoBar
                            x:Name="DiscoveryInfoBar"
                            Grid.Row="0"
                            Margin="24,0,24,10"
                            IsOpen="False"
                            Visibility="Collapsed"
                            IsClosable="False"
                            Severity="Informational"
                            Title="正在搜索附近设备"
                            Message="请确认两台设备位于同一局域网。" />
                        <Frame
                            x:Name="ContentFrame"
                            AllowDrop="True"
                            DragEnter="ContentFrame_DragOver"
                            DragOver="ContentFrame_DragOver"
                            DragLeave="ContentFrame_DragLeave"
                            Drop="ContentFrame_Drop"
                            Background="Transparent"
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </Grid>
                </Border>
            </NavigationView.Content>
            </NavigationView>
            <!--
                These named controls are retained for connection/transfer status code-behind,
                but must not be assigned to NavigationView.Header. A collapsed Header child still
                makes Header non-null and leaves the template's fixed header row in every page.
            -->
            <Grid
                x:Name="NavigationHeader"
                Height="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <local:HandCursorButton
                    x:Name="HeaderBackButton" AutomationProperties.AutomationId="MainWindow.HeaderBackButton"
                    Width="0"
                    Height="0"
                    Visibility="Collapsed"
                    Click="HeaderBackButton_Click" />
                <TextBlock x:Name="PageTitle" Text="首页" Visibility="Collapsed" />
                <TextBlock x:Name="HeaderStatusText" Text="正在启动局域网服务" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Visibility="Collapsed" />
            </Grid>
            <Canvas x:Name="PaneResizeCanvas" Canvas.ZIndex="20" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SizeChanged="PaneResizeCanvas_SizeChanged">
                <Slider
                    x:Name="PaneResizeHandle"
                    AutomationProperties.AutomationId="MainWindow.PaneResizeHandle"
                    AutomationProperties.Name="侧边栏宽度"
                    AutomationProperties.HelpText="使用左右方向键调整宽度，Home 和 End 跳到最小或最大宽度。"
                    Minimum="200" Maximum="420" Value="200"
                    SmallChange="10" LargeChange="20" StepFrequency="10"
                    ValueChanged="PaneResizeHandle_ValueChanged"
                    IsThumbToolTipEnabled="False" UseSystemFocusVisuals="True" IsTabStop="True"
                    Width="12" MinWidth="0"
                    Background="Transparent"
                    BorderBrush="{ThemeResource HingeM3OutlineVariantBrush}"
                    BorderThickness="0"
                    ToolTipService.ToolTip="拖动或使用左右方向键调整侧边栏宽度"
                    PointerPressed="PaneResizeHandle_PointerPressed"
                    PointerMoved="PaneResizeHandle_PointerMoved"
                    PointerReleased="PaneResizeHandle_PointerReleased"
                    PointerCaptureLost="PaneResizeHandle_PointerCaptureLost">
                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>
            </Canvas>
            <Border
                x:Name="DragCancelZone"
                Width="200"
                Margin="4"
                Padding="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Canvas.ZIndex="30"
                AllowDrop="True"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                CornerRadius="12"
                Background="{ThemeResource HingeM3SurfaceContainerBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="2"
                DragEnter="DragCancelZone_DragOver"
                DragOver="DragCancelZone_DragOver"
                DragLeave="DragCancelZone_DragLeave"
                Drop="DragCancelZone_Drop">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE711;" FontSize="30" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="DragCancelTitle" Text="取消发送" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DragCancelDescription" Text="松开鼠标取消本次发送" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
