<Page
    x:Class="Hinge.App.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hinge.App"
    NavigationCacheMode="Required">
    <Grid x:Name="RootGrid">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource HingePageStackStyle}">
            <local:HingeWrapPanel Spacing="12" LineSpacing="8" JustifyLastLine="True">
                <StackPanel Spacing="4">
                    <TextBlock Text="笔记" Style="{StaticResource HingePageTitleStyle}" />
                    <TextBlock Text="笔记保存在已连接的 Android 设备上，Windows 端提供完整的查看与编辑入口。" Style="{StaticResource HingePageDescriptionStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" />
                    <Button x:Name="NewNoteButton" Content="新建笔记" Click="NewNoteButton_Click" />
                </StackPanel>
            </local:HingeWrapPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" Title="笔记" Message="等待连接设备。" />

            <Border Style="{StaticResource HingeCardStyle}" Padding="16">
                <ListView x:Name="NotesList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="NotesList_ItemClick" />
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
