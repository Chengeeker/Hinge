<Page
    x:Class="Hinge.App.NotificationHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hinge.App"
    NavigationCacheMode="Required">
    <Grid x:Name="RootGrid">
        <local:HandCursorListView x:Name="HistoryList" SizeChanged="HistoryList_SizeChanged" AutomationProperties.AutomationId="NotificationHistoryPage.HistoryList" AutomationProperties.Name="手机历史通知" Margin="24,16,24,32"
                  IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="HistoryList_ItemClick" Loaded="HistoryList_Loaded"
                  ContainerContentChanging="HistoryList_ContainerContentChanging">
            <local:HandCursorListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </local:HandCursorListView.ItemContainerStyle>
            <local:HandCursorListView.ItemTemplate>
                <DataTemplate><ContentControl HorizontalContentAlignment="Stretch" /></DataTemplate>
            </local:HandCursorListView.ItemTemplate>
            <local:HandCursorListView.Header>
            <StackPanel Spacing="16" Margin="0,0,0,16">
                <local:HingeWrapPanel Spacing="12" LineSpacing="8" JustifyLastLine="True">
                    <StackPanel Spacing="4">
                        <TextBlock Text="手机历史通知" Style="{StaticResource HingePageTitleStyle}" />
                        <TextBlock Text="读取 Android 通知访问权限开启后收到的应用通知。点击微信或 QQ 通知时，优先打开 Windows 本机客户端，无法打开时再使用 Android 原通知入口。" Style="{StaticResource HingePageDescriptionStyle}" />
                    </StackPanel>
                    <local:HingeWrapPanel Spacing="8" LineSpacing="8" JustifyLastLine="False" VerticalAlignment="Center">
                        <ComboBox x:Name="ApplicationFilter" AutomationProperties.AutomationId="NotificationHistoryPage.ApplicationFilter" AutomationProperties.Name="筛选通知应用" Width="180" VerticalAlignment="Center" PlaceholderText="全部应用" SelectionChanged="ApplicationFilter_SelectionChanged"  MinHeight="36" />
                        <ComboBox x:Name="SortOptions" AutomationProperties.AutomationId="NotificationHistoryPage.SortOptions" AutomationProperties.Name="通知排序" MinWidth="180" VerticalAlignment="Center" SelectedIndex="1" SelectionChanged="SortOptions_SelectionChanged" MinHeight="36">
                            <ComboBoxItem Content="时间（早到晚）" Tag="asc" />
                            <ComboBoxItem Content="时间（晚到早）" Tag="desc" />
                        </ComboBox>
                        <local:HandCursorButton
                            x:Name="ClearButton" AutomationProperties.AutomationId="NotificationHistoryPage.ClearButton"
                            Content="清空"
                            MinHeight="36"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="ClearButton_Click" />
                        <local:HandCursorButton
                            x:Name="RefreshButton" AutomationProperties.AutomationId="NotificationHistoryPage.RefreshButton"
                            Style="{StaticResource HingeIconButtonStyle}"
                            Height="36"
                            MinHeight="36"
                            VerticalAlignment="Center"
                            Click="RefreshButton_Click"
                            ToolTipService.ToolTip="刷新通知"
                            AutomationProperties.Name="刷新通知">
                            <SymbolIcon Symbol="Refresh" />
                        </local:HandCursorButton>
                    </local:HingeWrapPanel>
                </local:HingeWrapPanel>

                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" Title="手机历史通知" Message="等待连接设备。" />
                <TextBlock x:Name="SummaryText" FontSize="14" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" />
                <ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" HorizontalAlignment="Center" IsActive="False" Visibility="Collapsed" />

            </StackPanel>
            </local:HandCursorListView.Header>
            <local:HandCursorListView.Footer>
                <local:HandCursorButton x:Name="LoadMoreButton" AutomationProperties.AutomationId="NotificationHistoryPage.LoadMoreButton" Content="加载更多通知" Margin="0,16,0,0"
                        Visibility="Collapsed" Click="LoadMoreButton_Click" />
            </local:HandCursorListView.Footer>
        </local:HandCursorListView>
    </Grid>
</Page>
