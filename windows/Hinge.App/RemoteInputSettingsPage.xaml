<Page xmlns:local="using:Hinge.App"
    x:Class="Hinge.App.RemoteInputSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer x:Name="RemoteInputScrollViewer" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="RemoteInputPageRoot" HorizontalAlignment="Stretch">
            <StackPanel Style="{StaticResource HingeSettingsPageStackStyle}" Spacing="24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <local:HandCursorButton x:Name="BackButton" AutomationProperties.AutomationId="RemoteInputSettingsPage.BackButton" AutomationProperties.Name="返回设置" ToolTipService.ToolTip="返回设置" Style="{StaticResource HingeIconButtonStyle}">
                        <SymbolIcon Symbol="Back" />
                    </local:HandCursorButton>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="手机远控电脑" Style="{StaticResource HingePageTitleStyle}" />
                        <TextBlock Text="把 Android 手机用作此电脑的触控板与游戏键鼠。" Style="{StaticResource HingePageDescriptionStyle}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource HingeCardStyle}">
                    <StackPanel Spacing="14">
                        <ToggleSwitch x:Name="AllowRemoteInputToggle" Header="允许 Android 手机控制此电脑" OnContent="已开启" OffContent="已关闭" AutomationProperties.AutomationId="RemoteInputSettingsPage.AllowRemoteInputToggle" />
                        <ToggleSwitch x:Name="RequireEncryptionToggle" Header="加密远控指令（可选）" OnContent="已开启" OffContent="局域网明文" AutomationProperties.AutomationId="RemoteInputSettingsPage.RequireEncryptionToggle" />
                        <TextBlock x:Name="RemoteInputStatusText" Text="已关闭" Style="{StaticResource HingeM3TitleMediumStyle}" AutomationProperties.AutomationId="RemoteInputSettingsPage.StatusText" />
                        <TextBlock x:Name="RemoteInputStatusDetailsText" Text="手机需在 Hinge 设置中启用远控，并从已连接电脑列表打开触控板。" Style="{StaticResource HingeM3BodyVariantStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HingeCardStyle}" Padding="0">
                    <local:HandCursorButton x:Name="GameLayoutSettingsButton" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemoteInputSettingsPage.GameLayoutSettingsButton" AutomationProperties.Name="游戏模式布局" Style="{StaticResource HingeM3SettingsRowButtonStyle}">
                        <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="Keyboard" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="游戏模式布局" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                <TextBlock Text="在电脑上编辑手机游戏按键并同步到手机" Style="{StaticResource HingeM3BodyVariantStyle}" />
                            </StackPanel>
                            <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </local:HandCursorButton>
                </Border>
                <Border x:Name="RemoteInputTokenPanel" Style="{StaticResource HingeCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="可选加密密钥" Style="{StaticResource HingeM3TitleMediumStyle}" /><TextBox x:Name="ControlTokenBox" AutomationProperties.AutomationId="RemoteInputSettingsPage.ControlToken" IsReadOnly="True" Header="仅在开启远控加密时需要；手机可选择安全保存" TextWrapping="Wrap" /><Button x:Name="RotateTokenButton" AutomationProperties.AutomationId="RemoteInputSettingsPage.RotateToken" Content="重置加密密钥并结束当前控制" />
                        <TextBlock Text="默认不要求输入密钥，远控指令在局域网明文传输；请只在可信网络使用。可开启上方加密开关启用 AES-GCM 并校验重放，此时需将电脑端密钥输入手机。关闭远控或断线会释放鼠标和键盘；文件等其他业务消息不在此加密范围。" Style="{StaticResource HingeM3BodyVariantStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
