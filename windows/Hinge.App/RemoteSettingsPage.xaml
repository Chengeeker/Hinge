<Page xmlns:local="using:Hinge.App"
    x:Class="Hinge.App.RemoteSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer x:Name="RemoteScrollViewer" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="RemotePageRoot" HorizontalAlignment="Stretch">
            <StackPanel Style="{StaticResource HingeSettingsPageStackStyle}" Spacing="24">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <local:HandCursorButton x:Name="BackButton" AutomationProperties.AutomationId="RemoteSettingsPage.BackButton" AutomationProperties.Name="返回设置" ToolTipService.ToolTip="返回设置" Style="{StaticResource HingeIconButtonStyle}">
                        <SymbolIcon Symbol="Back" />
                    </local:HandCursorButton>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="投屏与远控" Style="{StaticResource HingePageTitleStyle}" />
                        <TextBlock Text="选择投屏和控制方向。" Style="{StaticResource HingePageDescriptionStyle}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource HingeCardStyle}" Padding="0">
                        <local:HandCursorButton x:Name="PhoneScreenButton" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemoteSettingsPage.PhoneScreenButton" AutomationProperties.Name="手机投屏到电脑" Style="{StaticResource HingeM3SettingsRowButtonStyle}">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="Video" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="手机投屏到电脑" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock x:Name="PhoneSummaryText" Text="未运行" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                </Border>
                <Border Style="{StaticResource HingeCardStyle}" Padding="0">
                        <local:HandCursorButton x:Name="RemoteInputButton" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RemoteSettingsPage.RemoteInputButton" AutomationProperties.Name="手机远控电脑" Style="{StaticResource HingeM3SettingsRowButtonStyle}">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="TouchPointer" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="手机远控电脑" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock x:Name="RemoteSummaryText" Text="已关闭" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
