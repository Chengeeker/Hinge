<Page
    x:Class="Hinge.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource HingePageStackStyle}">
            <TextBlock Text="设置" Style="{StaticResource HingePageTitleStyle}" />
            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <Button
                        x:Name="PersonalizationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        ToolTipService.ToolTip="打开个性化设置"
                        AutomationProperties.Name="个性化设置">
                        <Grid Padding="14,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="0" Symbol="Edit" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="个性化" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="主题、窗口材质与背景图片" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <SymbolIcon Grid.Column="2" Symbol="Forward" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <StackPanel Spacing="8">
                    <TextBlock Text="自定义存储位置" FontSize="15" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="StoragePathTextBox"
                                Grid.Column="0"
                                IsReadOnly="True"
                                PlaceholderText="未设置时使用 Downloads\Hinge"
                                HorizontalAlignment="Stretch" />
                            <Button
                                x:Name="StorageButton"
                                Grid.Column="1"
                                Content="浏览"
                                MinWidth="72"
                                HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock
                            Text="批量保存文件和照片时使用此目录。更新应用不会清除该设置。"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Windows 通知" FontSize="15" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="NotificationStatusText"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="检查中…"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="OpenNotificationSettingsButton"
                                Grid.Column="1"
                                Content="打开通知设置"
                                HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock
                            Text="即使 Windows 系统通知被关闭，Hinge 仍会在窗口内显示手机短信和验证码。"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="连接安全" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="设置后，其他设备连接到本机时需要输入这个 6 位数字；留空表示不启用。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PairingCodeTextBox"
                                Grid.Column="0"
                                MaxLength="6"
                                PlaceholderText="输入 6 位数字"
                                HorizontalAlignment="Stretch" />
                            <Button x:Name="SavePairingCodeButton" Grid.Column="1" Content="保存" MinWidth="72" />
                            <Button x:Name="ClearPairingCodeButton" Grid.Column="2" Content="清除" MinWidth="72" />
                        </Grid>
                        <TextBlock x:Name="PairingCodeStatusText" Text="未启用本机配对码" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="AboutButton" Content="关于应用" HorizontalAlignment="Left" />
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Header="关闭窗口时最小化到托盘" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="开启后点击关闭按钮会隐藏窗口，仍可从系统托盘恢复或退出应用。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="ShowTrayBackgroundNoticeToggle" Header="显示后台运行提示" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="开启后，关闭窗口并最小化到托盘时会显示一次提示；关闭后不影响后台运行和托盘恢复。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="StartWithWindowsToggle" Header="开机启动" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="登录 Windows 后自动启动 Hinge。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="SilentStartupToggle" Header="静默启动" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="开机启动时不显示主窗口，应用会在系统托盘中运行。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SettingsStatusText" Text="当前使用 Windows 系统主题与系统强调色。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
