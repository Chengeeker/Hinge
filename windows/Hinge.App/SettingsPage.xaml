<Page
    x:Class="Hinge.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource HingePageStackStyle}">
            <TextBlock Text="设置" Style="{StaticResource HingePageTitleStyle}" />
                <StackPanel Spacing="8">
                    <Button
                        x:Name="PersonalizationButton" AutomationProperties.AutomationId="SettingsPage.PersonalizationButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        ToolTipService.ToolTip="打开个性化设置"
                        AutomationProperties.Name="个性化设置">
                        <Grid Padding="14,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="0" Symbol="Edit" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="个性化" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="主题、窗口材质与背景图片" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <SymbolIcon Grid.Column="2" Symbol="Forward" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="WindowsSettingsButton" AutomationProperties.AutomationId="SettingsPage.WindowsSettingsButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        ToolTipService.ToolTip="打开 Windows 设置"
                        AutomationProperties.Name="Windows 设置">
                        <Grid Padding="14,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="0" Symbol="Setting" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Windows 设置" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="开机启动、托盘行为与 Windows 通知" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <SymbolIcon Grid.Column="2" Symbol="Forward" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="TransferSettingsButton" AutomationProperties.AutomationId="SettingsPage.TransferSettingsButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        ToolTipService.ToolTip="打开传输与连接设置"
                        AutomationProperties.Name="传输与连接设置">
                        <Grid Padding="14,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Grid.Column="0" Symbol="Link" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="传输与连接" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="自定义接收位置、设备配对与 Android 唤醒" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <SymbolIcon Grid.Column="2" Symbol="Forward" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="CloudRelaySettingsButton" AutomationProperties.AutomationId="SettingsPage.CloudRelaySettingsButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        ToolTipService.ToolTip="打开 Cloud Relay 设置"
                        AutomationProperties.Name="Cloud Relay 设置">
                        <Grid Padding="14,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE724;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Cloud Relay" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="配置你自己的 Worker、Relay 密钥与设备注册" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <SymbolIcon Grid.Column="2" Symbol="Forward" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="WebDavSettingsButton" AutomationProperties.AutomationId="SettingsPage.WebDavSettingsButton" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="0" AutomationProperties.Name="WebDAV 设置">
                        <Grid Padding="14,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Globe" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="WebDAV" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="管理多个地址、账号与独立文件浏览标签" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                            <SymbolIcon Grid.Column="2" Symbol="Forward" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
