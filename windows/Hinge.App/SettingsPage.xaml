<Page xmlns:local="using:Hinge.App"
    x:Class="Hinge.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer x:Name="SettingsScrollViewer" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="SettingsPageContentRoot" HorizontalAlignment="Stretch">
        <StackPanel Style="{StaticResource HingeSettingsPageStackStyle}" Spacing="24">
            <TextBlock Text="设置" Style="{StaticResource HingePageTitleStyle}" />

            <StackPanel Spacing="12">
                <TextBlock Text="外观与应用" Style="{StaticResource HingeM3SectionHeaderStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource HingeCardStyle}" Padding="0">
                    <StackPanel>
                        <local:HandCursorButton
                            x:Name="PersonalizationButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="SettingsPage.PersonalizationButton"
                            Style="{StaticResource HingeM3SettingsRowButtonStyle}"
                            ToolTipService.ToolTip="打开个性化设置"
                            AutomationProperties.Name="个性化设置">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="Edit" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="个性化" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock Text="主题、窗口材质与背景图片" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                        <Border Height="1" Margin="60,0,20,0" Background="{ThemeResource HingeM3OutlineVariantBrush}" />
                        <local:HandCursorButton
                            x:Name="WindowsSettingsButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="SettingsPage.WindowsSettingsButton"
                            Style="{StaticResource HingeM3SettingsRowButtonStyle}"
                            ToolTipService.ToolTip="打开 Windows 设置"
                            AutomationProperties.Name="Windows 设置">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="Setting" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Windows 设置" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock Text="开机启动、托盘行为与 Windows 通知" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="设备与服务" Style="{StaticResource HingeM3SectionHeaderStyle}" Margin="4,0,0,0" />
                <Border Style="{StaticResource HingeCardStyle}" Padding="0">
                    <StackPanel>
                        <local:HandCursorButton x:Name="ScreenControlSettingsButton" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SettingsPage.ScreenControlSettingsButton" AutomationProperties.Name="投屏与远控" Style="{StaticResource HingeM3SettingsRowButtonStyle}">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="Video" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="投屏与远控" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock x:Name="ScreenControlSummaryText" Text="双向投屏、触控板与游戏控制" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                        <Border Height="1" Margin="60,0,20,0" Background="{ThemeResource HingeM3OutlineVariantBrush}" />
                        <local:HandCursorButton
                            x:Name="TransferSettingsButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="SettingsPage.TransferSettingsButton"
                            Style="{StaticResource HingeM3SettingsRowButtonStyle}"
                            ToolTipService.ToolTip="打开传输与连接设置"
                            AutomationProperties.Name="传输与连接设置">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="Link" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="传输与连接" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock Text="自定义接收位置、设备配对与 Android 唤醒" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                        <Border Height="1" Margin="60,0,20,0" Background="{ThemeResource HingeM3OutlineVariantBrush}" />
                        <local:HandCursorButton
                            x:Name="CloudRelaySettingsButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="SettingsPage.CloudRelaySettingsButton"
                            Style="{StaticResource HingeM3SettingsRowButtonStyle}"
                            ToolTipService.ToolTip="打开 Cloud Relay 设置"
                            AutomationProperties.Name="Cloud Relay 设置">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE724;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22" Foreground="{ThemeResource HingeM3PrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Cloud Relay" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock Text="配置你自己的 Worker、Relay 密钥与设备注册" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                        <Border Height="1" Margin="60,0,20,0" Background="{ThemeResource HingeM3OutlineVariantBrush}" />
                        <local:HandCursorButton
                            x:Name="WebDavSettingsButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="SettingsPage.WebDavSettingsButton"
                            Style="{StaticResource HingeM3SettingsRowButtonStyle}"
                            AutomationProperties.Name="WebDAV 设置">
                            <Grid Padding="20,16" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center"><SymbolIcon Symbol="Globe" Foreground="{ThemeResource HingeM3PrimaryBrush}" /></Viewbox>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="WebDAV" Style="{StaticResource HingeM3TitleMediumStyle}" />
                                    <TextBlock Text="管理多个地址、账号与独立文件浏览标签" Style="{StaticResource HingeM3BodyVariantStyle}" />
                                </StackPanel>
                                <SymbolIcon Grid.Column="2" Symbol="Forward" Foreground="{ThemeResource HingeM3OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </local:HandCursorButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
