<Page
    x:Class="Hinge.App.TodoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hinge.App"
    NavigationCacheMode="Required">
    <Grid x:Name="RootGrid">
        <ListView x:Name="TasksList" SizeChanged="TasksList_SizeChanged" AutomationProperties.AutomationId="TodoPage.TasksList" SelectionMode="None"  Margin="{StaticResource HingePageMargin}">
            <ListView.Header>
                <StackPanel Spacing="16" Margin="0,0,0,16">
            <local:HingeWrapPanel Spacing="12" LineSpacing="8" JustifyLastLine="True">
                <StackPanel Spacing="4">
                    <TextBlock Text="待办" Style="{StaticResource HingePageTitleStyle}" />
                    <TextBlock Text="在电脑上管理手机工作区中的待办事项，完成状态会立即保存到手机。" Style="{StaticResource HingePageDescriptionStyle}" />
                </StackPanel>
                <local:HingeWrapPanel Spacing="8" LineSpacing="8" JustifyLastLine="False" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" AutomationProperties.AutomationId="TodoPage.RefreshButton" Content="刷新" Click="RefreshButton_Click" />
                    <Button x:Name="NewTaskButton" AutomationProperties.AutomationId="TodoPage.NewTaskButton" Content="新建待办" Click="NewTaskButton_Click" />
                </local:HingeWrapPanel>
            </local:HingeWrapPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" Title="待办" Message="等待连接设备。" />

                </StackPanel>
            </ListView.Header>
        </ListView>
    </Grid>
</Page>
