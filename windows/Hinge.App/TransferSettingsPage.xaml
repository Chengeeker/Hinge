<Page
    x:Class="Hinge.App.TransferSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource HingePageStackStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackToSettingsButton"
                    Grid.Column="0"
                    Style="{StaticResource HingeIconButtonStyle}"
                    ToolTipService.ToolTip="返回设置"
                    AutomationProperties.Name="返回设置">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="传输与连接" Style="{StaticResource HingePageTitleStyle}" />
                    <TextBlock Text="设置文件接收位置、连接安全与 Android 自动唤醒。" Style="{StaticResource HingePageDescriptionStyle}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="文件接收" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="自定义存储位置" FontSize="15" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="StoragePathTextBox"
                            Grid.Column="0"
                            IsReadOnly="True"
                            PlaceholderText="未设置时使用 Downloads\Hinge"
                            HorizontalAlignment="Stretch" />
                        <Button x:Name="StorageButton" Grid.Column="1" Content="浏览" MinWidth="72" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="批量保存文件和照片时使用此目录。更新应用不会清除该设置。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="设备连接" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="历史设备" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="清理旧版本或重装产生的同名旧记录。需确认属于同一台手机；保留最近记录、当前连接和未完成传输目标，清理前自动备份。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Button x:Name="CleanDeviceHistoryButton" Content="清理重复历史设备" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="连接安全" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="设置后，其他设备连接到本机时需要输入这个 6 位数字；留空表示不启用。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PairingCodeTextBox" Grid.Column="0" MaxLength="6" PlaceholderText="输入 6 位数字" HorizontalAlignment="Stretch" />
                            <Button x:Name="SavePairingCodeButton" Grid.Column="1" Content="保存" MinWidth="72" />
                            <Button x:Name="ClearPairingCodeButton" Grid.Column="2" Content="清除" MinWidth="72" />
                        </Grid>
                        <TextBlock x:Name="PairingCodeStatusText" Text="未启用本机配对码" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Android 自动唤醒" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="右键发送文件时，先用短暂 BLE 广播唤醒已绑定的 Android Hinge，再沿用局域网连接传输。广播不承载文件或配对码。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <Button x:Name="StartBlePairingButton" Content="开启 60 秒 BLE 配对广播" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Android 无线调试" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="手机开启开发者选项中的无线调试后，首次输入配对地址、配对端口和 6 位码。电脑需安装 Android SDK Platform-Tools；保存的 ADB 主机密钥会继续使用，配对码不会保存。连接端口可能在手机重启后变化。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="WirelessAdbHostTextBox" PlaceholderText="手机 IP 地址，例如 192.168.1.20" HorizontalAlignment="Stretch" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WirelessAdbPairingPortTextBox" Grid.Column="0" PlaceholderText="配对端口" />
                            <TextBox x:Name="WirelessAdbConnectPortTextBox" Grid.Column="1" PlaceholderText="连接端口" />
                        </Grid>
                        <PasswordBox x:Name="WirelessAdbPairingCodeTextBox" MaxLength="6" PlaceholderText="首次配对时输入 6 位码" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="WirelessAdbPairButton" Content="配对并连接" />
                            <Button x:Name="WirelessAdbConnectButton" Content="连接" />
                            <Button x:Name="WirelessAdbPullLogsButton" Content="提取 Hinge 日志" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TransferSettingsStatusText" Text="传输与连接设置会立即保存。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
