<Page
    x:Class="Hinge.App.WindowsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Style="{StaticResource HingePageStackStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackToSettingsButton" AutomationProperties.AutomationId="WindowsSettingsPage.BackToSettingsButton"
                    Grid.Column="0"
                    Style="{StaticResource HingeIconButtonStyle}"
                    ToolTipService.ToolTip="返回设置"
                    AutomationProperties.Name="返回设置">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Windows 设置" Style="{StaticResource HingePageTitleStyle}" />
                    <TextBlock Text="管理 Hinge 在 Windows 上的启动、托盘与系统通知行为。" Style="{StaticResource HingePageDescriptionStyle}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="启动与托盘" FontSize="20" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="StartWithWindowsToggle" AutomationProperties.AutomationId="WindowsSettingsPage.StartWithWindowsToggle" Header="开机启动" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="登录 Windows 后自动启动 Hinge。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="SilentStartupToggle" AutomationProperties.AutomationId="WindowsSettingsPage.SilentStartupToggle" Header="静默启动" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="开机启动时不显示主窗口，应用会在系统托盘中运行。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" AutomationProperties.AutomationId="WindowsSettingsPage.MinimizeToTrayToggle" Header="关闭窗口时最小化到托盘" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="开启后点击关闭按钮会隐藏窗口，仍可从系统托盘恢复或退出应用。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="ShowTrayBackgroundNoticeToggle" AutomationProperties.AutomationId="WindowsSettingsPage.ShowTrayBackgroundNoticeToggle" Header="显示后台运行提示" OnContent="开启" OffContent="关闭" />
                    <TextBlock Text="开启后，关闭窗口并最小化到托盘时会显示一次提示；关闭后不影响后台运行和托盘恢复。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HingeCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Windows 通知" FontSize="20" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="NotificationStatusText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="检查中…"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button x:Name="OpenNotificationSettingsButton" AutomationProperties.AutomationId="WindowsSettingsPage.OpenNotificationSettingsButton" Grid.Column="1" Content="打开通知设置" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="即使 Windows 系统通知被关闭，Hinge 仍会在窗口内显示手机短信和验证码。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="SettingsStatusText" Text="Windows 设置会立即保存。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
